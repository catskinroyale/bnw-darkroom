{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-changelog.sh",
            "timeout": 15,
            "statusMessage": "Checking CHANGELOG.md is updated"
          }
        ]
      }
    ]
  }
}
